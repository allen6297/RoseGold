{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RoseGold",
  "scopeName": "source.rosegold",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.rosegold",
          "begin": "#/",
          "end": "/#"
        },
        {
          "name": "comment.line.number-sign.rosegold",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rosegold",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.rosegold", "match": "\\\\." }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rosegold",
          "match": "\\b(if|elif|else|while|for|in|match|break|continue|try|catch|raise|return|pass)\\b"
        },
        {
          "name": "keyword.other.rosegold",
          "match": "\\b(module|import|as|extends|uses|pub|internal|private|static)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.rosegold" },
            "2": { "name": "entity.name.function.rosegold" }
          }
        },
        {
          "match": "\\b(class|trait|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.rosegold" },
            "2": { "name": "entity.name.type.rosegold" }
          }
        },
        {
          "name": "storage.type.rosegold",
          "match": "\\b(func|class|trait|enum|var|const|init)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.rosegold",
      "match": "\\b(true|false)\\b"
    },
    "types": {
      "name": "entity.name.type.rosegold",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.rosegold" }
      }
    },
    "numbers": {
      "name": "constant.numeric.rosegold",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.rosegold",
      "match": "->|=>|==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!]"
    }
  }
}
