{
  "name": "rosegold",
  "publisher": "rosegold",
  "displayName": "RoseGold",
  "description": "Language support for RoseGold: syntax highlighting, editor config, and a native language server (diagnostics, hover, go-to-definition, completion).",
  "version": "0.3.0",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "rosegold",
        "aliases": ["RoseGold", "rosegold"],
        "extensions": [".rg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rosegold",
        "scopeName": "source.rosegold",
        "path": "./syntaxes/rosegold.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[rosegold]": {
        "editor.defaultFormatter": "rosegold.rosegold"
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "function.declaration:rosegold": { "foreground": "#FFC66D" },
          "function:rosegold": { "foreground": "#57AAF7" },
          "method.declaration:rosegold": { "foreground": "#FFC66D" },
          "method:rosegold": { "foreground": "#57AAF7" }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          { "scope": "entity.name.function.rosegold", "settings": { "foreground": "#FFC66D" } },
          { "scope": "entity.name.function.call.rosegold", "settings": { "foreground": "#57AAF7" } },
          { "scope": "keyword.control.flow.rosegold", "settings": { "foreground": "#C586C0" } }
        ]
      }
    },
    "breakpoints": [
      { "language": "rosegold" }
    ],
    "debuggers": [
      {
        "type": "rosegold",
        "label": "RoseGold",
        "languages": ["rosegold"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "Path to the .rg file to run", "default": "${file}" },
              "stopOnEntry": { "type": "boolean", "description": "Break at the first line", "default": false }
            }
          }
        },
        "initialConfigurations": [
          { "type": "rosegold", "request": "launch", "name": "Run RoseGold File", "program": "${file}", "stopOnEntry": false }
        ],
        "configurationSnippets": [
          {
            "label": "RoseGold: Launch File",
            "description": "Run and debug the current .rg file",
            "body": { "type": "rosegold", "request": "launch", "name": "Run RoseGold File", "program": "^\"\\${file}\"", "stopOnEntry": false }
          }
        ]
      }
    ],
    "configuration": {
      "title": "RoseGold",
      "properties": {
        "rosegold.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the rosegoldc binary (the language server runs as 'rosegoldc --lsp'). If empty, the extension searches the workspace and the file's parent folders for cpp/rosegoldc or rosegoldc."
        },
        "rosegold.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and the RoseGold language server."
        }
      }
    }
  }
}
