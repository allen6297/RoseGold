<idea-plugin>
  <id>dev.rosegold</id>
  <name>RoseGold</name>
  <vendor>RoseGold</vendor>
  <description><![CDATA[
    Language support for the RoseGold programming language (<code>.rg</code>):
    syntax highlighting, comment toggling, brace matching, and a color settings
    page, plus full language features (diagnostics, hover, go-to-definition,
    completion, references, rename, document symbols, signature help, semantic
    highlighting, folding, inlay hints) via the native <code>rosegoldc --lsp</code>
    language server, and debugging (breakpoints, stepping, variables) via
    <code>rosegoldc --dap</code> — both connected through LSP4IJ.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.redhat.devtools.lsp4ij</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="RoseGold file"
        implementationClass="dev.rosegold.RoseGoldFileType"
        fieldName="INSTANCE"
        language="RoseGold"
        extensions="rg"/>
    <lang.syntaxHighlighterFactory
        language="RoseGold"
        implementationClass="dev.rosegold.RoseGoldSyntaxHighlighterFactory"/>
    <lang.parserDefinition
        language="RoseGold"
        implementationClass="dev.rosegold.RoseGoldParserDefinition"/>
    <lang.commenter
        language="RoseGold"
        implementationClass="dev.rosegold.RoseGoldCommenter"/>
    <lang.braceMatcher
        language="RoseGold"
        implementationClass="dev.rosegold.RoseGoldBraceMatcher"/>
    <colorSettingsPage
        implementation="dev.rosegold.RoseGoldColorSettingsPage"/>
  </extensions>

  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server
        id="rosegold"
        name="RoseGold Language Server"
        factoryClass="dev.rosegold.RoseGoldLspFactory"/>
    <languageMapping
        language="RoseGold"
        serverId="rosegold"/>
    <semanticTokensColorsProvider
        serverId="rosegold"
        class="dev.rosegold.RoseGoldSemanticTokensColorsProvider"/>
    <debugAdapterServer
        id="rosegold-dap"
        name="RoseGold Debugger"
        factoryClass="dev.rosegold.RoseGoldDapFactory"/>
  </extensions>
</idea-plugin>
