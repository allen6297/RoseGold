# macOS
.DS_Store

# Compiled RoseGold toolchain binary (built from cpp/src/*)
/cpp/rosegoldc

# VS Code extension deps
editors/vscode/node_modules/

# JetBrains / Gradle build output
editors/jetbrains/build/
editors/jetbrains/.gradle/
editors/jetbrains/.kotlin/

# IDE settings (machine-specific)
.idea/

# Python bytecode (python-reference oracle)
__pycache__/
*.pyc

# IntelliJ Platform Gradle plugin state
editors/jetbrains/.intellijPlatform/

# Embedding demo binary
cpp/embed/engine
cpp/embed/game
cpp/embed/hotreload
cpp/embed/externdemo
cpp/embed/linkcheck
